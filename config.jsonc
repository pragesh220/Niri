
{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
"source": "Nixos", // Options: "cachyos", "arch", "linux", or path to a .txt file| for custom image ko lagi: "source": "/path/to/image.png" !image chai png hunu parxa
//"width": 30,
        "padding": {
            "top": 1,
            "left": 2
},
    "color": {
      "1": "#d79921",
      "2": "#98971a",
      "3": "#458588",
      "4": "#b16286",
      "5": "#cc241d",
      "6": "#d65d0e"
    }

},
"display": {
"separator": " 󰑃  "
},
"modules": [
    "break",
    {
    "type": "os",
    "key": " DISTRO",
    "keyColor": "#cc241d"
    },
    {
    "type": "kernel",
    "key": "│ ├",
    "keyColor": "#cc241d"
    },
    {
    "type": "packages",
    "key": "│ ├󰏖",
    "keyColor": "#cc241d"
    },
    {
        "type": "command",
        "key": "│ ├",
        "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
        "keyColor": "#cc241d"
    },
    {
    "type": "shell",
    "key": "│ └",
    "keyColor": "#cc241d"
    },
    {
    "type": "wm",
    "key": " WM",
    "keyColor": "#98971a"
    },
  {
    "type": "de",
    "key": "│ ├ ",
    "keyColor": "#98971a",
  },
 {
    "type": "wmtheme",
    "key": "│ ├󰉼 ",
    "keyColor": "#98971a",
  },
  {
    "type": "icons",
    "key": "│ ├󰀻 ",
    "keyColor": "#98971a",
  },
  {
        "type": "cursor",
        "key": "│ ├󰆿",
        "keyColor": "#98971a",
    },
    {
        "type": "terminalfont",
        "key": "│ ├",
        "keyColor": "#98971a",
    },
    {
    "type": "terminal",
    "key": "│ └",
    "keyColor": "#98971a"
    },
    {
    "type": "host",
    "key": "󰌢 SYSTEM",
    "keyColor": "#458588"
    },
    {
    "type": "cpu",
    "key": "│ ├",
    "keyColor": "#458588"
    },
    {
    "type": "gpu",
    "key": "│ ├󰢮",
    "format": "{2}",
    "keyColor": "#458588"
    },
   // {
     //       "type": "display",
    //"key": "│ ├󰍹",
   // "keyColor": "#458588",
   // "compactType": "original-with-refresh-rate"
   // },
    {
    "type": "memory",
    "key": "│ ├",
    "keyColor": "#458588"
    },
    {
    "type": "swap",
    "key": "│ ├󰿡",
    "keyColor": "#458588"
    },
      {
    "type": "disk",
    "key": "│ ├󰋊",
    "keyColor": "#458588",
  },
    {
    "type": "uptime",
    "key": "│ ├󰅐",
    "keyColor": "#458588"
    },
    {
    "type": "display",
    "key": "│ └󰹑",
    "keyColor": "#458588"
    },
    {
    "type":"battery"
    },

    {
    "type": "custom",
     // A more colorful, balanced dot array for the bottom
      //                  yellow                     red                      orange                        yellow                light green                     green                   aqua green                liht blue                          dark blue            blue                          purple                     violet                       magenta                                                       
      "format": "\u001b[38;2;250;189;47m󰮯 - \u001b[38;2;204;36;29m󰊠 - \u001b[38;2;254;128;25m󰊠 - \u001b[38;2;250;189;47m󰊠 - \u001b[38;2;184;187;38m󰊠 - \u001b[38;2;152;151;26m󰊠 - \u001b[38;2;104;157;106m󰊠 - \u001b[38;2;131;165;152m󰊠 - \u001b[38;2;7;102;120m󰊠 - \u001b[38;2;69;133;136m󰊠 - \u001b[38;2;143;63;113m󰊠 - \u001b[38;2;177;98;134m󰊠 - \u001b[38;2;211;134;155m󰊠  \u001b[0m"
    },
    "break",
    ]
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "Nixos",
    "padding": {
      "top": 1,
      "left": 2
    },

     "color": {
      "1": "#d79921",
      "2": "#98971a",
      "3": "#458588",
      "4": "#b16286",
      "5": "#cc241d",
      "6": "#d65d0e"
},   

  },

  "display": {
    "disableLinewrap": true
  },

  "modules": [
    // --- HARDWARE (Red) ---
    {
      "type": "custom",
      "format": "\u001b[31m┌──────────────────────Hardware──────────────────────┐\u001b[0m"
    },

    {
      "type": "host",
      "key": " System",
      "keyColor": "red"
    },

    {
      "type": "cpu",
      "key": "│ ├ ",
      "showPeCoreCount": true,
      "keyColor": "red"
    },

    {
      "type": "gpu",
      "key": "│ ├ ",
      "detectionMethod": "pci",
      "format": "{name}",
      "keyColor": "red"
    },

    {
      "type": "display",
      "key": "│ ├󱄄 ",
      "keyColor": "red"
    },

    {
      "type": "disk",
      "key": "│ ├󰋊 ",
      "keyColor": "red"
    },

    {
      "type": "memory",
      "key": "│ ├ ",
      "keyColor": "red"
    },

    {
      "type": "swap",
      "key": "└ └󰿢 ",
      "keyColor": "red"
    },

    {
      "type": "custom",
      "format": "\u001b[31m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    
    // --- SOFTWARE (Green) ---
    {
      "type": "custom",
      "format": "\u001b[32m┌──────────────────────Software──────────────────────┐\u001b[0m"
    },

    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "green",
    },

    {
      "type": "kernel",
      "key": "│ ├ ",
      "keyColor": "green"
    },

    {
      "type": "wm",
      "key": "│ ├ ",
      "keyColor": "green"
    },

    {
      "type": "de",
      "key": " DE ",
      "keyColor": "green"
    },

    {
      "type": "shell",
      "key": "│ ├ ",
      "keyColor": "green"
    },

    {
      "type": "terminal",
      "key": "│ ├ ",
      "keyColor": "green"
    },

    {
      "type": "packages",
      "key": "│ ├󰏖 ",
      "keyColor": "green"
    },

    {
      "type": "wmtheme",
      "key": "│ ├󰸌 ",
      "keyColor": "green"
    },

    {
      "type": "custom",
      "key": "│ ├󰸌 ",
      "keyColor": "green",
      "format": "\u001b[38;2;250;189;47m󰮯 - \u001b[38;2;204;36;29m󰊠 - \u001b[38;2;254;128;25m󰊠 - \u001b[38;2;250;189;47m󰊠 - \u001b[38;2;184;187;38m󰊠 - \u001b[38;2;152;151;26m󰊠 - \u001b[38;2;104;157;106m󰊠 - \u001b[38;2;131;165;152m󰊠 - \u001b[38;2;7;102;120m󰊠 - \u001b[38;2;69;133;136m󰊠 - \u001b[38;2;143;63;113m󰊠 - \u001b[38;2;177;98;134m󰊠  \u001b[0m"
    },

    {
      "type": "terminalfont",
      "key": "└ └ ",
      "keyColor": "green"
    },

    {
      "type": "custom",
      "format": "\u001b[32m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    
    // --- AGE / UPTIME / UPDATE (Blue) ---
    {
      "type": "custom",
      "format": "\u001b[34m┌────────────────Age / Uptime────────────────────────┐\u001b[0m"
    },

    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "blue",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },

    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "blue"
    },

    {
      "type": "custom",
      "format": "\u001b[34m└────────────────────────────────────────────────────┘\u001b[0m"
    },
    "break"
  ]
}
